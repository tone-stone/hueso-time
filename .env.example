# Opcional: activar backend remoto
# EXPO_PUBLIC_USE_API=1
# EXPO_PUBLIC_API_URL=http://localhost:8787

# Login con Google (Gmail) — ver docs/GOOGLE_AUTH.md
# Creá OAuth clients en https://console.cloud.google.com/apis/credentials
# - Web application (obligatorio; da el idToken en Android)
# - Android: package com.tonestone.huesotime + SHA-1 del keystore EAS
# - iOS: bundle com.tonestone.huesotime
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Opcional si no querés derivar el scheme del iOS client id:
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.XXXX

# Pruebas locales: 1 = entrar sin login
# Producción/preview EAS: forzado a 0 en eas.json
EXPO_PUBLIC_SKIP_AUTH=1

# URL del backend (búsqueda Spotify / proxy Sheets)
# EXPO_PUBLIC_API_URL=http://localhost:8787
