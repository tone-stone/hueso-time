# Opcional: activar backend remoto
# EXPO_PUBLIC_USE_API=1
# EXPO_PUBLIC_API_URL=http://localhost:8081

# Login con Google (Gmail) — ver docs/GOOGLE_AUTH.md
# Creá OAuth clients en https://console.cloud.google.com/apis/credentials
# - Web application (obligatorio; da el idToken en Android)
# - Android: package com.tonestone.huesotime + SHA-1 del keystore EAS
# - iOS: bundle com.tonestone.huesotime
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Opcional si no querés derivar el scheme del iOS client id:
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.XXXX

# Pruebas locales: 1 = entrar sin login
# Producción/preview EAS: forzado a 0 en eas.json
EXPO_PUBLIC_SKIP_AUTH=1

# URL del backend (búsqueda Spotify / proxy Sheets)
# EXPO_PUBLIC_API_URL=http://localhost:8081
# Obligatorio para las rutas de datos: OAuth client IDs aceptados (web, iOS, Android)
GOOGLE_CLIENT_IDS=785682234203-9vtfndcqiml95it6427903fivpf2kd4i.apps.googleusercontent.com,785682234203-r4umd1ct3f8tb7jcsh0d39lvu5u9978n.apps.googleusercontent.com,785682234203-8n64trh9ksljapcc3fol73qusnj5hdnt.apps.googleusercontent.com
# Login con Google (Gmail)
# Creá OAuth clients en https://console.cloud.google.com/apis/credentials
# - Web application: para web / Expo
# - iOS: bundle com.tonestone.huesotime
# - Android: package com.tonestone.huesotime + SHA-1 del keystore EAS
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=785682234203-9vtfndcqiml95it6427903fivpf2kd4i.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=785682234203-r4umd1ct3f8tb7jcsh0d39lvu5u9978n.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=785682234203-8n64trh9ksljapcc3fol73qusnj5hdnt.apps.googleusercontent.com
# Opcional: directorio persistente; ejecutar un único proceso por directorio
# DATA_DIR=/ruta/persistente/hueso-time
