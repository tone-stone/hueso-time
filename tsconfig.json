{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "backend",
    "node_modules",
    "ios",
    "android",
    "design_handoff_hueso_time_redesign",
    "**/*.test.ts",
    "vitest.config.mts"
  ]
}
